      "python_code": "class Solution:\n    def isValid(self, s: str) -> bool:\n        stack = []\n\n        s_map = {\n            ')': '(', \n            '}': '{', \n            ']': '['\n        }\n\n        for c in s:\n            if c in s_map:\n                curr = '#'\n                if stack:\n                    curr = stack.pop()\n                \n                if s_map[c] != curr:\n                    return False\n            \n            else:\n                stack.append(c)\n\n        return not stack",
