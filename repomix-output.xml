      "python_code": "# Definition for singly-linked list.\n# class ListNode:\n#     def __init__(self, val=0, next=None):\n#         self.val = val\n#         self.next = next\nclass Solution:\n    def reorderList(self, head: Optional[ListNode]) -> None:\n        \"\"\"\n        Do not return anything, modify head in-place instead.\n        \"\"\"\n        if not head or not head.next:\n            return\n\n        p1 = head\n        p2 = head.next\n        while p2 and p2.next:\n            p1 = p1.next\n            p2 = p2.next.next\n\n        second = p1.next\n        prev = None\n        p1.next = None\n\n        while second:\n            nxt = second.next\n            second.next = prev\n            prev = second\n            second = nxt\n\n        first = head\n        second = prev\n        while second:\n            temp1 = first.next\n            temp2 = second.next\n            first.next = second\n            second.next = temp1\n            first = temp1\n            second = temp2",
