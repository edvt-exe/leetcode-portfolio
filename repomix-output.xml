<file path=".github/workflows/sync.yml">
name: Sync LeetCode Data

on:
  push:
    branches: [main]

# Prevents two syncs racing each other if pushes land close together.
concurrency:
  group: sync-leetcode-data
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  sync:
    runs-on: ubuntu-latest
    # Skip runs triggered by the bot's own commit (belt-and-suspenders on
    # top of the "[skip ci]" in the commit message below).
    if: github.actor != 'github-actions[bot]'

    steps:
      - name: Checkout portfolio repo
        uses: actions/checkout@v4
        with:
          path: leetcode-portofolio
          fetch-depth: 1

      - name: Checkout solutions repo
        uses: actions/checkout@v4
        with:
          repository: ${{ vars.SOLUTIONS_REPO || 'edvt-exe/leetcode-explained' }}
          path: leetcode-explained
          fetch-depth: 1

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Run sync script
        working-directory: leetcode-portofolio
        env:
          SOLUTIONS_REPO_PATH: ${{ github.workspace }}/leetcode-explained
          GITHUB_USERNAME: ${{ github.repository_owner }}
        run: python3 scripts/sync.py

      - name: Commit and push changes
        working-directory: leetcode-portofolio
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          if git diff --quiet -- database.json README.md; then
            echo "No changes to database.json or README.md — nothing to commit."
            exit 0
          fi

          git add database.json README.md
          git commit -m "chore: sync leetcode data [skip ci]"
          git push
</file>

